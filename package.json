{
  "name": "ton-swe-challenge-api",
  "version": "1.0.0",
  "description": "API de autenticacao e listagem paginada de produtos — SWE Challenge Ton/Stone",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run test/unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:load": "tsx scripts/load-test.ts",
    "test:watch": "vitest test/unit",
    "test:coverage": "vitest run test/unit --coverage",
    "test:coverage:all": "vitest run --config vitest.coverage.config.ts --coverage",
    "prepare": "husky",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "db:create": "tsx --env-file-if-exists=.env scripts/create-table.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "lint:no-scan": "! grep -rn 'ScanCommand' src/ || (echo 'Varredura no código de produção: use Query com índice.' && exit 1)",
    "package:lambda": "tsx scripts/package-lambda.ts",
    "verify:lambda": "tsx scripts/verify-lambda-artifact.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@fastify/aws-lambda": "^6.4.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/aws-serverless": "^10.73.0",
    "@sentry/node": "^10.73.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
