# ---------------------------------------------------------------------------
# Copie para `.env` (`cp .env.example .env`) e ajuste. Nenhuma variável abaixo
# tem valor de produção: o parser em `src/infrastructure/config/env.ts` recusa
# subir a aplicação se algo obrigatório faltar ou estiver malformado.
# ---------------------------------------------------------------------------

# --- Aplicação -------------------------------------------------------------
# Ambiente de execução. Afeta formato de log e exposição do Swagger.
NODE_ENV=development
# Porta do servidor HTTP local. Irrelevante no Lambda.
PORT=3000
# Nível mínimo de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Identifica a versão nos logs e no Sentry. No CI, use o SHA do commit.
APP_VERSION=local

# --- Autenticação ----------------------------------------------------------
# Segredo HMAC do JWT. Mínimo de 32 caracteres (256 bits).
# Gere um valor real com: openssl rand -base64 48
# Em produção vem do AWS SSM Parameter Store (SecureString), nunca do arquivo.
JWT_SECRET=troque-este-valor-por-um-segredo-de-no-minimo-32-caracteres
# Claims `iss` e `aud` validadas na verificação do token.
JWT_ISSUER=ton-swe-challenge
JWT_AUDIENCE=ton-swe-challenge-api
# Validade do access token, em segundos. Curto de propósito: a renovação é
# feita pelo refresh token rotativo (issue #4).
JWT_ACCESS_TTL_SECONDS=900
# Validade do refresh token, em segundos (7 dias).
REFRESH_TOKEN_TTL_SECONDS=604800

# --- Política de bloqueio de conta ----------------------------------------
# Tentativas erradas antes do bloqueio temporário.
LOCKOUT_MAX_ATTEMPTS=5
# Primeiro bloqueio, em milissegundos (30s), com backoff exponencial.
LOCKOUT_BASE_DELAY_MS=30000
# Teto do bloqueio, em milissegundos (15min). Impede que o lockout vire
# ferramenta de negação de serviço contra usuários legítimos.
LOCKOUT_MAX_DELAY_MS=900000

# --- Persistência ----------------------------------------------------------
AWS_REGION=us-east-1
# Nome da tabela DynamoDB (single-table design).
TABLE_NAME=ton-challenge-dev
# Apenas para desenvolvimento: aponta o SDK para o DynamoDB Local.
# Deixe VAZIO ou remova para usar a AWS real.
DYNAMODB_ENDPOINT=http://localhost:8000
# Credenciais fake exigidas pelo DynamoDB Local. Na AWS real, remova as duas e
# deixe o SDK resolver via role/perfil.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Rate limit ------------------------------------------------------------
# Janela deslizante de 1 minuto para cada política.
RATE_LIMIT_PRODUCTS_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=20
# Se o armazenamento do rate limit falhar, `true` deixa a requisição passar
# (prioriza disponibilidade) e `false` recusa com 429 (prioriza proteção).
RATE_LIMIT_FAIL_OPEN=true

# --- HTTP ------------------------------------------------------------------
# Origens permitidas no CORS, separadas por vírgula. `*` libera todas.
CORS_ORIGINS=*
# Expõe a documentação interativa em /docs. Desligue em produção.
SWAGGER_ENABLED=true

# --- Observabilidade -------------------------------------------------------
# DSN do Sentry. Vazio desliga o Sentry (comportamento padrão em dev e CI).
SENTRY_DSN=
# Fração de transações rastreadas (0 a 1). Alto demais custa caro e adiciona latência.
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Seed (script de carga inicial) ---------------------------------------
SEED_USER_EMAIL=demo@ton.com.br
SEED_USER_PASSWORD=Desafio@Ton2026
SEED_PRODUCT_COUNT=250
