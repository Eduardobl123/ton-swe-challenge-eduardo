# dependências
node_modules/

# build
dist/
*.tsbuildinfo

# testes
coverage/
.vitest-cache/

# ambiente — nunca commitar segredos
.env
.env.*
!.env.example

# terraform
#
# O arquivo de trava (.terraform.lock.hcl) é versionado de propósito: ele fixa a
# versão e o resumo do provedor, e sem ele cada máquina resolve uma versão
# diferente. Um plano que só falha na máquina de alguém é o pior tipo de
# divergência.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# artefato do Lambda, produzido por npm run package:lambda
dist/

SWE_Challenge-Back-TREM.pdf

# sistema operacional / editores
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
