{
  "compilerOptions": {
    /* Saída e módulos — ESM puro; o bundle final é gerado pelo tsup/esbuild. */
    // Alvo e biblioteca acompanham o runtime, e não a última versão do
    // TypeScript. O Node 24 implementa ES2024 por inteiro, mais os grupos
    // `ESNext` listados abaixo (auxiliares de iterador, métodos de conjunto,
    // `Error.isError`, `Promise.try`, `Array.fromAsync`). Declarar menos do que
    // o runtime oferece esconde API disponível; declarar mais deixa passar no
    // typecheck código que quebra na invocação. A lista segue `@tsconfig/node24`.
    "target": "ES2024",
    "lib": [
      "ES2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // A configuração de cobertura estende a base por import direto; sem isto o
    // TypeScript recusa a extensão explícita que o Vite pede.
    "allowImportingTsExtensions": true,

    /* Rigor de tipos — exigido pela issue #1. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    /* Interop e performance. */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "vitest.coverage.config.ts",
    "tsup.config.ts"
  ]
}
